{
  "name": "iam-lens",
  "description": "IAM Lens: two-way Google Cloud IAM role and permission lookup",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "zip:store": "IAM_STORE_BUILD=1 IAM_OUT_DIR=.output-store wxt zip",
    "postinstall": "wxt prepare",
    "gen:theme": "tsx scripts/gen-theme.ts",
    "gen:service-icons": "node scripts/build-service-icons.ts",
    "gen:icons": "tsx scripts/gen-icons.ts",
    "gen:brand": "tsx scripts/gen-icon.ts",
    "gen:consent-logo": "tsx scripts/gen-consent-logo.ts",
    "shots": "SCREENSHOTS=1 playwright test screenshots",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "store:assets": "STORE_ASSETS=1 playwright test store-assets",
    "check:bundle": "node scripts/check-bundle.ts"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-code": "^5.3.2",
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "idb": "^8.0.4",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@material-symbols/svg-400": "^0.49.0",
    "@material/material-color-utilities": "^0.4.0",
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "wxt": "^0.21.5"
  }
}
